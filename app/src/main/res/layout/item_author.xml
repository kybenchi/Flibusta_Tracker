<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/authorName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/customBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✏️ своё имя"
            android:textSize="11sp"
            android:textColor="#333333"
            android:background="@drawable/badge_bg"
            android:paddingLeft="8dp" android:paddingRight="8dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/authorUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/purple_primary"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/authorMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Искать за (дней):"
            android:textSize="13sp"
            android:textColor="#555555" />

        <EditText
            android:id="@+id/cutoffInput"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:layout_marginStart="8dp"
            android:background="@drawable/input_bg"
            android:padding="8dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveCutoff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💾"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/gray_btn" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <Button android:id="@+id/btnCheckNew"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="🔍 Новые" android:layout_marginEnd="4dp"
            android:backgroundTint="@color/green_btn"/>
        <Button android:id="@+id/btnCheckFull"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="🔄 Все" android:layout_marginEnd="4dp"
            android:backgroundTint="@color/gray_btn"/>
        <Button android:id="@+id/btnEditName"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="✏️ Имя" android:layout_marginEnd="4dp"
            android:backgroundTint="@color/orange_btn"/>
        <Button android:id="@+id/btnDelete"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="🗑️"
            android:backgroundTint="@color/red_btn"/>
    </LinearLayout>
</LinearLayout>
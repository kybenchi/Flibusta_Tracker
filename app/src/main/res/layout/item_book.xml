<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/bookTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/bookDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:background="@drawable/date_badge_bg"
            android:paddingLeft="10dp" android:paddingRight="10dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/bookAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/purple_primary"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/bookDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#666666"
        android:textStyle="italic"
        android:textSize="13sp"
        android:background="@drawable/desc_bg"
        android:padding="10dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">
        <Button android:id="@+id/btnPage"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📄 Страница" android:layout_marginEnd="6dp"
            android:backgroundTint="@color/purple_primary"/>
        <Button android:id="@+id/btnFb2"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="FB2" android:layout_marginEnd="6dp"
            android:backgroundTint="@color/green_btn"/>
        <Button android:id="@+id/btnPdf"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PDF" android:layout_marginEnd="6dp"
            android:backgroundTint="@color/green_btn"/>
        <Button android:id="@+id/btnEpub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="EPUB" android:layout_marginEnd="6dp"
            android:backgroundTint="@color/green_btn"/>
        <Button android:id="@+id/btnMobi"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MOBI"
            android:backgroundTint="@color/green_btn"/>
    </LinearLayout>

    <TextView
        android:id="@+id/bookFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#999999"
        android:textSize="11sp"
        android:layout_gravity="end"
        android:layout_marginTop="6dp" />
</LinearLayout>